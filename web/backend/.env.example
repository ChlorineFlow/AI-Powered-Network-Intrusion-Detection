# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Downstream ML inference service
ML_API_URL=http://localhost:8000

# PostgreSQL (prediction history + alerts persistence)
DATABASE_URL=postgres://nids_user:nids_password@localhost:5432/nids_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=nids_db
PGUSER=nids_user
PGPASSWORD=nids_password

# Uploads
MAX_UPLOAD_SIZE_MB=25
